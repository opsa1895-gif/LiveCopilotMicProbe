<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.livecopilot.micprobe"
    android:versionCode="53"
    android:versionName="0.52.0-file-callback-freshness" >

    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
    </queries>

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:label="Live Copilot"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar" >
        <activity
            android:name="com.livecopilot.micprobe.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.livecopilot.micprobe.MicProbeAccessibilityService"
            android:exported="true"
            android:label="Live Copilot overlay"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" >
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>